<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://android.com">

    <!-- 🔐 Floating Widget Permissions (Fixed) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_menu_agenda"
        android:label="My Floating Widget"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <!-- 📱 Main Screen (MainActivity) -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ⚙️ Floating Widget Service -->
        <service
            android:name=".FloatingWidgetService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property 
                android:name="android.app.PROPERTY_SPECIAL_USE_FALCON_SERVICE_TYPE" 
                android:value="Floating widget display over other apps" />
        </service>

    </application>
</manifest>
